# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Expo
.expo/
dist/
web-build/

# Expo CNG / Prebuild
# Native projects are generated artifacts — `expo prebuild` / EAS Build regenerate them
# from app.json + the root google-services.json / GoogleService-Info.plist.
# EXCEPTION: android/app/debug.keystore is force-tracked (git add -f). Its SHA-1 is
# registered in Firebase and is REQUIRED for local Google Sign-In. Do NOT run
# `expo prebuild --clean` unless you restore that keystore afterward.
/android
/ios
